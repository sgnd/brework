# Brewfile.apps: GUI and App Store apps for a Dev & Ops Mac
# The Brewfile loads this file. Skip these apps with: install.sh --cli-only
# The remote desktop apps (near the end) are only installed with: install.sh --remote-desktop
#
# How to add something:
#   App:            cask "name"            find the name with: brew search --cask name
#   App Store app:  mas "Name", id: 123    the id is the number in the App Store link
#
# Put it in the right section below, with a short comment.
# Use mas when the app is not in Homebrew, or when you want the App Store version.
# mas apps need you to be signed in to the App Store.
# To remove something, delete its line.

# ----------------------------------------------------------------------------
# App Store tools
# ----------------------------------------------------------------------------
brew "mas"                # Install App Store apps from the terminal

# ----------------------------------------------------------------------------
# Editors & terminals
# ----------------------------------------------------------------------------
cask "visual-studio-code" # Code editor
cask "cursor"             # AI code editor
cask "warp"               # Terminal

# ----------------------------------------------------------------------------
# AI assistants
# ----------------------------------------------------------------------------
cask "claude"             # Claude desktop app
cask "chatgpt"            # ChatGPT desktop app

# ----------------------------------------------------------------------------
# API clients
# ----------------------------------------------------------------------------
cask "postman"            # Test HTTP APIs

# ----------------------------------------------------------------------------
# Chat
# ----------------------------------------------------------------------------
cask "slack"              # Team chat
cask "discord"            # Community chat
mas "Telegram", id: 747648890                    # Messaging app
mas "WhatsApp Messenger", id: 310633997          # Messaging app
mas "WeChat", id: 836500024                      # Messaging app

# ----------------------------------------------------------------------------
# Video meetings
# ----------------------------------------------------------------------------
cask "microsoft-teams"    # Video meetings and team chat
cask "zoom"               # Video meetings
cask "voov-meeting"       # Video meetings (Tencent Meeting outside China)

# ----------------------------------------------------------------------------
# Remote access
# ----------------------------------------------------------------------------
mas "Termius", id: 1176074088                    # SSH client

# ----------------------------------------------------------------------------
# Remote desktop: only with install.sh --remote-desktop
# These apps let someone else control this Mac. TeamViewer runs a background
# service as root, and Homebrew does not check the AnyDesk download against a
# fixed checksum. So they are only installed when you ask for them.
# ----------------------------------------------------------------------------
if ENV["HOMEBREW_BREWORK_REMOTE_DESKTOP"] == "1"
  cask "teamviewer"       # Remote desktop
  cask "anydesk"          # Remote desktop
end

# ----------------------------------------------------------------------------
# Networking & VPN
# ----------------------------------------------------------------------------
cask "cloudflare-warp"    # Cloudflare VPN
cask "openvpn-connect"    # VPN client

# ----------------------------------------------------------------------------
# Virtual machines
# ----------------------------------------------------------------------------
cask "utm"                # Run Linux and Windows virtual machines

# ----------------------------------------------------------------------------
# Browsers
# ----------------------------------------------------------------------------
cask "google-chrome"      # Web browser

# ----------------------------------------------------------------------------
# Apple developer tools
# ----------------------------------------------------------------------------
mas "Xcode", id: 497799835                       # Apple developer tools
